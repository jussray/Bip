{
  "version": 2,
  "reviewedAt": "2026-08-18",
  "providerInventory": {
    "workers": [
      "sekret-backend",
      "sekret-backend-alpha"
    ],
    "pages": [
      "sekret-bip"
    ]
  },
  "production": {
    "pages": {
      "name": "sekret-bip",
      "role": "frontend",
      "buildCommand": "npm run build:web",
      "outputDirectory": "dist"
    },
    "worker": {
      "name": "sekret-backend",
      "entrypoint": "worker/voice-entry.ts",
      "roles": [
        "authenticated-api",
        "sekret-reply",
        "voice",
        "transcription",
        "bridge-summary",
        "safety-and-push",
        "inbound-email-routing"
      ]
    }
  },
  "nonProduction": {
    "worker": {
      "name": "sekret-backend-alpha",
      "config": "wrangler.alpha.toml",
      "status": "founder-gated"
    }
  },
  "legacyDashboardServices": [
    {
      "name": "bip-mail",
      "kind": "worker",
      "status": "retired-provider-absent",
      "action": "do-not-recreate"
    },
    {
      "name": "sekret",
      "kind": "worker",
      "status": "retired-provider-absent",
      "action": "do-not-recreate"
    }
  ]
}
