{
  "version": 1,
  "reviewedAt": "2026-07-29",
  "production": {
    "pages": {
      "name": "sekret-bip",
      "role": "frontend",
      "buildCommand": "npm run build:web",
      "outputDirectory": "dist"
    },
    "worker": {
      "name": "sekret-backend",
      "entrypoint": "worker/voice-entry.ts",
      "roles": [
        "authenticated-api",
        "sekret-reply",
        "voice",
        "transcription",
        "bridge-summary",
        "safety-and-push",
        "inbound-email-routing"
      ]
    }
  },
  "nonProduction": {
    "worker": {
      "name": "sekret-backend-alpha",
      "config": "wrangler.alpha.toml",
      "status": "founder-gated"
    }
  },
  "legacyDashboardServices": [
    {
      "name": "bip-mail",
      "kind": "worker",
      "action": "retire-after-email-routing-cutover"
    },
    {
      "name": "sekret",
      "kind": "worker",
      "action": "retire-after-route-binding-and-traffic-audit"
    }
  ]
}
