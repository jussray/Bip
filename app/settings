  voiceInfo: { backgroundColor: C.card, padding: 10 },
  voiceName: { fontSize: 12, color: C.white, fontWeight: '700' },
  voiceTitle: { fontSize: 10, color: C.muted, marginTop: 2 },
  checkmark: { position: 'absolute', top: 8, right: 8, width: 22, height: 22, borderRadius: 11, backgroundColor: C.purple, alignItems: 'center', justifyContent: 'center' },
  profileItem: { flexDirection: 'row', alignItems: 'center', gap: 12, padding: 12, borderRadius: 14, marginBottom: 8, borderWidth: 1, backgroundColor: 'rgba(255,255,255,0.03)', borderColor: C.border },
  profileItemActive: { backgroundColor: 'rgba(124,58,237,0.25)', borderColor: '#a855f7' },
  profileName: { fontSize: 13, color: C.white, fontWeight: '600' },
  profileVibe: { fontSize: 11, color: C.muted },
  langBtn: { flex: 1, alignItems: 'center', padding: 10, borderRadius: 14, borderWidth: 1, backgroundColor: 'rgba(255,255,255,0.03)', borderColor: C.border },
  langBtnActive: { backgroundColor: 'rgba(124,58,237,0.25)', borderColor: '#a855f7' },
  langLabel: { fontSize: 9, color: C.muted },
  sideBtn: { flex: 1, padding: 14, borderRadius: 14, alignItems: 'center', borderWidth: 1, backgroundColor: 'rgba(255,255,255,0.03)', borderColor: C.border },
  sideBtnActive: { backgroundColor: 'rgba(124,58,237,0.25)', borderColor: '#a855f7' },
  sideBtnText: { fontSize: 13, color: C.muted, fontWeight: '600' },
  currentSide: { fontSize: 11, color: C.muted, textAlign: 'center', marginTop: 12 },
  noteCard: { marginHorizontal: 16, marginBottom: 16, backgroundColor: 'rgba(124,58,237,0.1)', borderRadius: 18, borderWidth: 1, borderColor: 'rgba(168,85,247,0.2)', padding: 16, alignItems: 'center' },
  noteText: { fontSize: 13, color: C.lavender, fontStyle: 'italic', textAlign: 'center', lineHeight: 20 },
});
