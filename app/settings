import React from 'react';
import {
  View, Text, ScrollView, Image, ImageBackground,
  TouchableOpacity, StyleSheet, Platform,
} from 'react-native';
import { LinearGradient } from 'expo-linear-gradient';
import { StatusBar } from 'expo-status-bar';
import { useSekret } from './_layout';
import BottomNav from '../components/BottomNav';
import { C, IMAGES, THEME_PACKS, SEKRET_PROFILES } from '../constants/theme';

export default function SettingsScreen() {
  const { userSide, setUserSide, theme, setTheme, selectedSekret, setSelectedSekret } = useSekret();

  return (
    <View style={styles.container}>
      <StatusBar style="light" />
      <ScrollView contentContainerStyle={styles.scroll} showsVerticalScrollIndicator={false}>

        <View style={styles.heroWrap}>
          <ImageBackground source={IMAGES.bgRayleneRoomDay} style={styles.heroBg} resizeMode="cover">
            <LinearGradient colors={['rgba(13,9,20,0.2)', 'rgba(13,9,20,0.9)']} style={StyleSheet.absoluteFill} />
            <View style={styles.heroContent}>
              <Text style={styles.heroSub}>make se'kret feel like yours</Text>
              <Text style={styles.heroTitle}>Vibe Lab 💜</Text>
            </View>
          </ImageBackground>
        </View>

        {/* Theme packs */}
        <View style={[styles.card, { flexDirection: 'column' }]}>
          <Text style={styles.cardTitle}>Theme Packs</Text>
          <Text style={[styles.cardSub, { marginBottom: 14 }]}>Themes, vibes, and more.</Text>
          <View style={styles.themeRow}>
            {Object.keys(THEME_PACKS).map(key => (
              <TouchableOpacity key={key} onPress={() => setTheme(key)} style={{ alignItems: 'center', gap: 6 }}>
                <View style={[styles.themeBubble, { backgroundColor: THEME_PACKS[key].card }, theme === key && styles.themeBubbleActive]}>
                  <Text style={{ fontSize: 24 }}>{THEME_PACKS[key].emoji}</Text>
                </View>
                <Text style={[styles.themeLabel, theme === key && { color: C.pinkHot, fontWeight: '700' }]}>
                  {THEME_PACKS[key].name.split(' ')[0]}
                </Text>
              </TouchableOpacity>
            ))}
          </View>
        </View>

        {/* Choose Se'kret */}
        <View style={[styles.card, { flexDirection: 'column' }]}>
          <Text style={styles.cardTitle}>Choose Your Se'kret</Text>
