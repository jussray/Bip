              <Text style={{ fontSize: 24 }}>{SEKRET_PROFILES[key].emoji}</Text>
              <View style={{ flex: 1 }}>
                <Text style={styles.profileName}>{SEKRET_PROFILES[key].name}</Text>
                <Text style={styles.profileVibe}>{SEKRET_PROFILES[key].vibe}</Text>
              </View>
              {selectedSekret === key && <View style={styles.checkmark}><Text style={{ fontSize: 11, color: '#fff' }}>✓</Text></View>}
            </TouchableOpacity>
          ))}
        </View>

        {/* Language */}
        <View style={[styles.card, { flexDirection: 'column' }]}>
          <Text style={[styles.cardTitle, { marginBottom: 14 }]}>Language</Text>
          <View style={{ flexDirection: 'row', gap: 10 }}>
            {[{flag:'🇺🇸',label:'English'},{flag:'🇪🇸',label:'Español'},{flag:'🇫🇷',label:'Français'},{flag:'🇭🇹',label:'Kreyòl'}].map((lang, i) => (
              <TouchableOpacity key={lang.label} style={[styles.langBtn, i === 0 && styles.langBtnActive]}>
                <Text style={{ fontSize: 22, marginBottom: 4 }}>{lang.flag}</Text>
                <Text style={[styles.langLabel, i === 0 && { color: C.lavender, fontWeight: '700' }]}>{lang.label}</Text>
              </TouchableOpacity>
            ))}
          </View>
        </View>

        {/* Account side */}
        <View style={[styles.card, { flexDirection: 'column' }]}>
          <Text style={[styles.cardTitle, { marginBottom: 14 }]}>Account Side</Text>
          <View style={{ flexDirection: 'row', gap: 10 }}>
            {[{label:'🧑 Teen Side',side:'teen'},{label:'👩‍👧 Parent Side',side:'parent'}].map(opt => (
              <TouchableOpacity key={opt.side} onPress={() => setUserSide(opt.side as any)} style={[styles.sideBtn, userSide === opt.side && styles.sideBtnActive]}>
                <Text style={[styles.sideBtnText, userSide === opt.side && { color: C.lavender }]}>{opt.label}</Text>
              </TouchableOpacity>
            ))}
          </View>
          <Text style={styles.currentSide}>Current: {userSide === 'parent' ? 'Parent 🌿' : 'Teen 💜'}</Text>
        </View>

        <View style={styles.noteCard}>
          <Text style={styles.noteText}>Note to self:{'\n'}Progress, not perfection. 💜</Text>
        </View>

      </ScrollView>
      <BottomNav userSide={userSide} />
    </View>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, backgroundColor: C.bg },
  scroll: { paddingBottom: 100 },
  heroWrap: { marginHorizontal: 16, marginTop: Platform.OS === 'ios' ? 56 : 40, marginBottom: 12, borderRadius: 24, overflow: 'hidden' },
  heroBg: { width: '100%', minHeight: 150 },
  heroContent: { padding: 18, minHeight: 150, justifyContent: 'flex-end' },
  heroSub: { fontSize: 11, color: '#a855f7', letterSpacing: 1, marginBottom: 4 },
