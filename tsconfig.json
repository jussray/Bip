{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      // ── Canonical alias (new code uses this) ──────────────────────────────
      "@/*": ["./src/*"],

      // ── Legacy aliases (resolve to src/ via shim files) ───────────────────
      // Keep until Step 5 (screens/ retirement). Do not remove early.
      "@hooks/*":      ["./src/hooks/*"],
      "@utils/*":      ["./src/utils/*"],
      "@components/*": ["./src/components/*"],
      "@constants/*":  ["./src/constants/*"],
      "@screens/*":    ["./screens/*"],
      "@types/*":      ["./src/types/*"]
    }
  }
}
