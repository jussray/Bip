{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@hooks/*":      ["hooks/*"],
      "@utils/*":      ["utils/*"],
      "@components/*": ["components/*"],
      "@constants/*":  ["constants/*"],
      "@screens/*":    ["screens/*"],
      "@types/*":      ["types/*"]
    }
  }
}
