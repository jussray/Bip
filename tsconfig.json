{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*":           ["./*"],
      "@hooks/*":      ["./hooks/*",      "./src/hooks/*"],
      "@utils/*":      ["./utils/*",      "./src/utils/*"],
      "@components/*": ["./components/*"],
      "@constants/*":  ["./constants/*",  "./src/constants/*"],
      "@screens/*":    ["./screens/*"],
      "@types/*":      ["./types/*",      "./src/types/*"],
      "@store/*":      ["./src/store/*"],
      "@handlers/*":   ["./src/handlers/*"]
    }
  }
}
