{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      // ── New canonical alias (points into src/) ──────────────────────
      // Use @/* for ALL new code going forward.
      // e.g. import { useAuthStore } from '@/store';
      //      import { AgeGate }       from '@/components/safety';
      "@/*": ["./src/*"],

      // ── Legacy aliases (kept for backward compatibility) ────────────
      // These still resolve so no existing import breaks.
      // Migrate to @/* over time; remove these once screens/ is retired.
      "@hooks/*":      ["./hooks/*"],
      "@utils/*":      ["./utils/*"],
      "@components/*": ["./components/*"],
      "@constants/*":  ["./constants/*"],
      "@screens/*":    ["./screens/*"],
      "@types/*":      ["./types/*"]
    }
  }
}
