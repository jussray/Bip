{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*":           ["./src/*"],
      "@hooks/*":      ["./src/hooks/*"],
      "@utils/*":      ["./src/utils/*"],
      "@components/*": ["./src/components/*"],
      "@constants/*":  ["./src/constants/*"],
      "@screens/*":    ["./screens/*"],
      "@types/*":      ["./src/types/*"]
    }
  }
}
