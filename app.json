{
  "expo": {
    "name": "Se'kret Bip",
    "slug": "sekret-bip",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "sekret",
    "splash": {
      "image": "./assets/images/sekret-splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#160028"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sekretbip.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#160028"
      },
      "package": "com.sekretbip.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}
