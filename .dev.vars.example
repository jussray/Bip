# .dev.vars.example
# Copy to .dev.vars for local Wrangler development. Never commit real values.

OPENAI_API_KEY=your-openai-api-key

# Shared bearer token for reply, voice, and transcription routes.
# Generate a long random value and use the matching public client value locally.
BIP_CLIENT_TOKEN=your-shared-worker-client-token

# Local development escape hatch only. Never set this on a deployed Worker.
# ALLOW_INSECURE_LOCAL_DEV=true

RAYLENE_VOICE_ID=
RYLANE_VOICE_ID=
CLOUD_VOICE_ID=
NIGHT_VOICE_ID=
SEKRET_VOICE_ID=
PARENT_COACH_VOICE_ID=
