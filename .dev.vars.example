# .dev.vars.example
#
# Used by `wrangler dev` for local secret injection.
# Copy to .dev.vars and fill in real values.
# .dev.vars is gitignored — NEVER commit real values here.
#
#   cp .dev.vars.example .dev.vars

# ── Worker Secrets ────────────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# Supabase dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Any strong random string (openssl rand -hex 32)
SAFETY_SCAN_SECRET=your-safety-scan-secret
