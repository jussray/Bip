{
  "name": "sekret-bip",
  "version": "1.0.0",
  "description": "A private emotional wellness and self-expression app built with React Native and Expo.",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "vercel-build": "expo export -p web",
    "test": "node --test \"test/**/*.test.mjs\"",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "typecheck": "npm run type-check",
    "audit:runtime-assets": "node scripts/audit-runtime-assets.mjs",
    "validate:companions": "node scripts/validate-companion-assets.mjs",
    "verify:room-archives": "node scripts/verify-room-archives.js",
    "verify:bundle": "npx expo export --platform web --clear",
    "verify:prepush": "npm run audit:runtime-assets && npm run validate:companions && npm run type-check && npm run lint && npm run verify:bundle && npm run verify:room-archives",
    "test:device-sync": "node --test scripts/test-device-sync.mjs",
    "test:oracle": "node scripts/test-oracle-discovery.mjs",
    "test:voice-intelligence": "node scripts/test-voice-intelligence.mjs",
    "deploy": "npm run vercel-build && wrangler deploy",
    "preview": "npm run vercel-build && wrangler dev"
  },
  "dependencies": {
    "@expo/log-box": "^56.0.13",
    "@expo/metro-runtime": "~56.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.74.0",
    "@vercel/analytics": "^2.0.1",
    "expo": "^56.0.12",
    "expo-av": "~16.0.8",
    "expo-constants": "^56.0.18",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image-picker": "~56.0.18",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "^56.0.14",
    "expo-modules-core": "~56.0.17",
    "expo-notifications": "^56.0.18",
    "expo-router": "^56.2.11",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "^56.0.10",
    "expo-status-bar": "~56.0.4",
    "jose": "^6.2.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "~4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "^0.8.3",
    "react-server-dom-webpack": "~19.2.4"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~19.2.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "babel-preset-expo": "~56.0.0",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~56.0.4",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.61.0",
    "wrangler": "^4.100.0"
  },
  "optionalDependencies": {
    "node-addon-api": "^8.8.0",
    "sharp": "^0.35.2"
  }
}
