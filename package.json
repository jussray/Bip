{
  "name": "sekret-bip",
  "version": "1.0.0",
  "description": "A private emotional wellness and self-expression app built with React Native and Expo.",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "vercel-build": "expo export -p web",
    "test": "node --test",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "audit:runtime-assets": "node scripts/audit-runtime-assets.mjs",
    "verify:room-archives": "node scripts/verify-room-archives.js",
    "verify:bundle": "npx expo export --platform web --clear",
    "verify:prepush": "npm run audit:runtime-assets && npm run type-check && npm run lint && npm run verify:bundle && npm run verify:room-archives",
    "test:device-sync": "node --test scripts/test-device-sync.mjs",
    "test:oracle": "node scripts/test-oracle-discovery.mjs",
    "test:voice-intelligence": "node scripts/test-voice-intelligence.mjs",
    "deploy": "npm run vercel-build && wrangler deploy",
    "preview": "npm run vercel-build && wrangler dev"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@supabase/supabase-js": "2.74.0",
    "@vercel/analytics": "^2.0.1",
    "expo": "~56.0.12",
    "expo-av": "~15.0.2",
    "expo-constants": "~17.0.8",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-image-picker": "~16.0.6",
    "expo-linear-gradient": "~14.0.2",
    "expo-linking": "~7.0.5",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.19",
    "expo-secure-store": "~14.0.1",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.2.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.79.4",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-safe-area-context": "4.14.1",
    "react-native-screens": "~4.10.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.20",
    "babel-plugin-module-resolver": "^5.0.0",
    "babel-preset-expo": "~13.0.0",
    "eslint": "^8.57.1",
    "eslint-config-expo": "^8.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.61.0",
    "wrangler": "^4.100.0"
  },
  "optionalDependencies": {
    "node-addon-api": "^8.8.0",
    "sharp": "^0.35.2"
  }
}
