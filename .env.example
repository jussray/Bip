# Se'kret Bip — environment variables (example)
#
# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings -> API). NEVER commit .env.local — it's already
# in .gitignore.
#
# Only EXPO_PUBLIC_* vars ship to the client. NEVER put the service_role
# key here — that key bypasses Row Level Security and stays server-side only.

# ── Supabase ─────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Backend API (Cloudflare Worker) ───────────────────────────────────────────
# After deploying the Worker (`wrangler deploy`), set this to your Worker URL.
# Custom domain example: https://api.bipapp.com
# workers.dev example:  https://bip.<your-account>.workers.dev
# Leave empty to run in offline/fallback mode (AI replies will use local strings).
EXPO_PUBLIC_BACKEND_URL=

# ── Worker secrets (server-side ONLY — set via `wrangler secret put`) ─────────
# OPENAI_API_KEY is a Cloudflare Worker secret. It must NEVER appear here or
# in any Expo/client file. Set it once:
#   wrangler secret put OPENAI_API_KEY
# OPENAI_API_KEY=           <-- intentionally blank, never fill this in here
