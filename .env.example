# .env.example — SAFE TO COMMIT. No real secret values here.
# Copy to .env.local and fill in real values.
# .env, .env.local, .dev.vars, and local secret files are gitignored.

# ── App / Expo public config ───────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key-here
EXPO_PUBLIC_BACKEND_URL=https://bip.your-subdomain.workers.dev

# Interim shared Worker token. This value is embedded in the client bundle and
# can be extracted, so it is only a speed bump paired with Worker rate limits.
# It must match the Worker secret BIP_CLIENT_TOKEN. Supabase JWT auth replaces
# this later without changing the Worker routes.
EXPO_PUBLIC_BIP_CLIENT_TOKEN=replace-with-the-same-long-random-token

APP_ENV=development

# ── Local design-tool secret ───────────────────────────────────────────
# Used only by the local Figma Context MCP process. Never expose this to
# the Expo app, prefix it with EXPO_PUBLIC_, or commit the real value.
FIGMA_API_KEY=figd_your-new-personal-access-token-here

# ── Cloudflare Worker secret ───────────────────────────────────────────
# Do NOT put real Worker secrets in this file.
# Set them on Cloudflare instead:
#   npx wrangler secret put OPENAI_API_KEY --name bip
#   npx wrangler secret put BIP_CLIENT_TOKEN --name bip
OPENAI_API_KEY=sk-your-openai-key-here
BIP_CLIENT_TOKEN=replace-with-a-long-random-token

# ── Supabase Edge Function secrets ─────────────────────────────────────
# Do NOT put real values in this file.
# Set these on Supabase instead:
#   supabase secrets set SAFETY_SCAN_SECRET=your-random-shared-secret
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#   supabase secrets set OPENAI_API_KEY=your-openai-api-key
#
# The Postgres trigger secret must match SAFETY_SCAN_SECRET:
#   ALTER DATABASE postgres SET app.safety_scan_secret = '<same-value>';
SAFETY_SCAN_SECRET=your-safety-scan-secret-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
