# Se'kret Bip — Environment Variables
#
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local — it is already in .gitignore.
#
# Expo requires EXPO_PUBLIC_* prefix for client-visible vars.
# This is NOT a Next.js project — do NOT use NEXT_PUBLIC_* here.
#
# Quick setup:
#   cp .env.example .env.local
#   Fill in the two project blocks below.

# ── Primary project (jvmbhralyktmdlvglrxk) ────────────────────────────────────
# Keys from: Supabase Dashboard → jvmbhralyktmdlvglrxk → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://jvmbhralyktmdlvglrxk.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<paste anon key from dashboard>
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_RQmhIG93iy4rBlwj0Jmbvg_kMoKabKo

# ── Secondary project (tbsevonvegdnlyjgplmm) ──────────────────────────────────
# Only needed if you are explicitly targeting this project.
# Keys from: Supabase Dashboard → tbsevonvegdnlyjgplmm → Project Settings → API
# EXPO_PUBLIC_SUPABASE_URL_2=https://tbsevonvegdnlyjgplmm.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY_2=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRic2V2b252ZWdkbmx5amdwbG1tIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODEzNTg3MjIsImV4cCI6MjA5NjkzNDcyMn0.MKJK6FJNlrsfvIn-sFnzxHxTcXG_KOuddZkM2h0yY2c
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY_2=sb_publishable_F57sxdjeDJGZuIZdix_UKg_zGKDvNTk

