# Se'kret Bip — Environment Variables
#
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local — it is already in .gitignore.
#
# Expo requires EXPO_PUBLIC_* prefix for client-visible vars.
# This is NOT a Next.js project — do NOT use NEXT_PUBLIC_* here.
#
# Quick setup:
#   cp .env.example .env.local
#   Then fill in each value from your Supabase and Cloudflare dashboards.

# ── Primary Supabase project ─────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-supabase-publishable-key>

# ── Secondary Supabase project (optional) ────────────────────────────────────
# Uncomment if you are explicitly targeting a second project.
# EXPO_PUBLIC_SUPABASE_URL_2=https://<your-second-project-ref>.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY_2=<your-second-supabase-anon-key>
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY_2=<your-second-supabase-publishable-key>

# ── Backend API (Cloudflare Worker) ─────────────────────────────────────────
EXPO_PUBLIC_BACKEND_URL=https://<your-worker-name>.<your-account>.workers.dev

# ── Worker Secrets — NEVER put these in this file ───────────────────────────
# OPENAI_API_KEY lives only in the Cloudflare Worker secret store.
# Set once with:  wrangler secret put OPENAI_API_KEY
# SUPABASE_SERVICE_ROLE_KEY similarly stays server-side only — never here.
