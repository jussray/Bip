# Se'kret Bip — Environment Variables
#
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local — it is already in .gitignore.
#
# Expo requires EXPO_PUBLIC_* prefix for client-visible vars.
# This is NOT a Next.js project — do NOT use NEXT_PUBLIC_* here.
#
# Quick setup:
#   cp .env.example .env.local
#
# ── Where to find these values ────────────────────────────────────────────────
#   Supabase URL + anon key: https://supabase.com/dashboard → project → Settings → API
#   Publishable key:         https://supabase.com/dashboard → project → Settings → API → Publishable key
#   Backend URL:             Cloudflare dashboard → Workers → bip → Triggers
#
# ── Worker secrets (server-side only — use `wrangler secret put`) ─────────────
#   OPENAI_API_KEY           https://platform.openai.com/api-keys
#   SUPABASE_SERVICE_ROLE_KEY  Supabase dashboard → Settings → API → service_role key
#   SAFETY_SCAN_SECRET       any strong random string you generate

# ── Primary Supabase project ──────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ── Backend API (Cloudflare Worker) ───────────────────────────────────────────
EXPO_PUBLIC_BACKEND_URL=https://bip.your-subdomain.workers.dev

# ── Worker Secrets — NEVER put real values here ───────────────────────────────
# These live only in the Cloudflare Worker secret store.
# Run once per environment:
#   wrangler secret put OPENAI_API_KEY
#   wrangler secret put SUPABASE_SERVICE_ROLE_KEY
#   wrangler secret put SAFETY_SCAN_SECRET
