EXPO_PUBLIC_BACKEND_URL=https://bip.mcgill-raylene.workers.dev

# ── Worker Secrets — NEVER put these in this file ─────────────────────────────
# OPENAI_API_KEY lives only in the Cloudflare Worker secret store.
# Set once with:  wrangler secret put OPENAI_API_KEY
# SUPABASE_SERVICE_ROLE_KEY similarly stays server-side only — never here.
