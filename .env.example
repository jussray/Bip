# .env.example — SAFE TO COMMIT. No real values here.
# Copy to .env (local React Native / Expo) and fill in real values.
# .env and .dev.vars are both gitignored.
#
# ── Supabase ──────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key-here

# ⚠ SECRET — never commit the real value. Set via `wrangler secret put`.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── OpenAI ────────────────────────────────────────────────────────────────
# ⚠ SECRET — never commit the real value. Set via `wrangler secret put`.
OPENAI_API_KEY=sk-your-openai-key-here

# ── Worker / Safety ───────────────────────────────────────────────────────
# ⚠ SECRET — never commit the real value. Set via `wrangler secret put`.
SAFETY_SCAN_SECRET=your-safety-scan-secret-here

# ── App ───────────────────────────────────────────────────────────────────
EXPO_PUBLIC_BACKEND_URL=https://bip.your-subdomain.workers.dev
APP_ENV=development
