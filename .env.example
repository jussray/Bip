# ─────────────────────────────────────────────────────────────────────────────
# Se'kret Bip — environment template
#
# Copy to `.env.local` (NEVER commit .env.local — it is gitignored).
# Only EXPO_PUBLIC_* vars are bundled into the client. NEVER put a
# Supabase service_role key here — that key is server-side only.
# ─────────────────────────────────────────────────────────────────────────────

# Backend Configuration (legacy custom backend, optional)
EXPO_PUBLIC_BACKEND_URL=http://YOUR_LOCAL_IP:8001

# App Environment
EXPO_PUBLIC_APP_ENV=development

# Supabase (Phase 2 — fill in when you start wiring the backend)
# Project URL, e.g. https://abcd1234.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
# Public anon key (safe to ship on device — NOT the service_role key)
EXPO_PUBLIC_SUPABASE_ANON_KEY=
