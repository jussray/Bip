# Se'kret Bip — Environment Variables
#
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local — it is already in .gitignore.
#
# Only EXPO_PUBLIC_* vars are shipped to the client.
# NEVER put service_role or OPENAI_API_KEY here.
#
# Quick setup:
#   1. Copy: cp .env.example .env.local
#   2. Fill in values from Supabase → Project Settings → API
#   3. Fill in BACKEND_URL after: wrangler deploy

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project ref: tbsevonvegdnlyjgplmm
EXPO_PUBLIC_SUPABASE_URL=https://tbsevonvegdnlyjgplmm.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Backend API (Cloudflare Worker) ───────────────────────────────────────────
# After deploying the Worker (`wrangler deploy`), paste your Worker URL here.
# workers.dev example:  https://bip-worker.<your-account>.workers.dev
# Custom domain example: https://api.bipapp.com
# Leave blank to run Se'kret AI in local fallback mode.
EXPO_PUBLIC_BACKEND_URL=

# ── Worker Secrets — NEVER put these in this file ─────────────────────────────
# OPENAI_API_KEY lives only in the Cloudflare Worker secret store.
# Set it once with:  wrangler secret put OPENAI_API_KEY
# It must NEVER appear in any Expo, Vercel, or client file.
#
# OPENAI_API_KEY=   <-- intentionally absent — do not add this
#
# Supabase service_role key similarly stays server-side only.
# SUPABASE_SERVICE_ROLE_KEY=  <-- never here
