# Se'kret Bip — environment variables (example)
#
# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings -> API). NEVER commit .env.local — it's already
# in .gitignore.
#
# Only EXPO_PUBLIC_* vars ship to the client. NEVER put the service_role
# key here — that key bypasses Row Level Security and stays server-side only.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
